<Project Sdk="Microsoft.NET.Sdk.Web">

  <PropertyGroup>
    <RootNamespace>Splitlab.E2E.Host</RootNamespace>
    <IsPackable>false</IsPackable>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.EntityFrameworkCore.Sqlite" Version="8.0.11" />
    <!-- Newer than the 2.1.6 that EF Core pulls in: that one bundles a SQLite with CVE-2025-6965 (fixed in 2.1.12), and NuGet
         audit fails our warnings-as-errors build on it. -->
    <PackageReference Include="SQLitePCLRaw.lib.e_sqlite3" Version="2.1.14" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\src\Splitlab.Api\Splitlab.Api.csproj" />
  </ItemGroup>

</Project>
